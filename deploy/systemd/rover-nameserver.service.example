# Rover Nameserver（单机）systemd 示例
# 1. 把 jar 放到 /opt/rover/，配置放到 /opt/rover/config/
# 2. 复制本文件为 /etc/systemd/system/rover-nameserver.service
# 3. systemctl daemon-reload && systemctl enable --now rover-nameserver

[Unit]
Description=Rover Nameserver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rover
WorkingDirectory=/opt/rover
Environment=ROVER_STRICT_SECURITY=true
# 按需改 jar 名与 JVM 参数
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/rover/rover-nameserver-bootstrap.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
