FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY . .
RUN mvn -pl rover-gateway-bootstrap -am -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /src/rover-gateway-bootstrap/target/rover-gateway-bootstrap-1.0.0-SNAPSHOT.jar app.jar
COPY deploy/docker/config/rover-gateway.yml config/rover-gateway.yml
EXPOSE 80
ENTRYPOINT ["java", "-jar", "app.jar"]
