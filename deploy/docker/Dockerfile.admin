FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY . .
RUN mvn -pl rover-admin -am -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /src/rover-admin/target/rover-admin-1.0.0-SNAPSHOT.jar app.jar
COPY deploy/docker/config/application.yml config/application.yml
EXPOSE 9090
ENTRYPOINT ["java", "-jar", "app.jar"]
