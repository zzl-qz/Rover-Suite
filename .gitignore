.DS_Store
Thumbs.db
*.swp
*.swo
*~
.~lock.*
.history

backups/
**/backups/

# ===== 临时文件 =====
*.tmp
*.temp
*.bak
*.orig
.attach_*
.vscode-server/
.trae/

# ===== Node / 前端依赖（勿入库）=====
node_modules/
**/node_modules/

# ===== Java 生成产物 =====
hs_err_pid*
replay_pid*
*.hprof

# ===== Gateway 用户扩展插件 =====
plugins/*.jar
!plugins/.gitkeep
rover-gateway-test/plugin-demo/demo-config/plugins/*.jar

# Eval / 测试产物（含 H2 库、录制日志与脱敏快照，不入库）
artifacts/

