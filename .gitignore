# ===== Maven 构建产物 =====
target/
*/target/
dependency-reduced-pom.xml
**/dependency-reduced-pom.xml
*.jar.original
*.war.original

# ===== 本地运行时配置（可含密钥，不入库）=====
# 整个目录忽略：Gateway / Nameserver 的本地配置、覆盖文件，以及 Admin 的模型配置
# config/admin-model.properties（含 api-key-enc 密文）与 config/master.key。
# 程序在文件缺失时会自动创建，因此新克隆的仓库不需要它。
# 如需入库示例配置，用 !config/xxx.example.yml 单独放行。
config/

# ===== 日志文件 =====
*.log
logs/
**/logs/
*.log.*
*.out.log
nohup.out

# ===== 敏感信息 / 凭据 =====
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials
.credentials
application-local.yml
application-local.yaml
application-private.yml
application-private.yaml
application-dev.yml
application-secret.yml
*.password
*.secret
id_rsa
id_rsa.pub
*.p8
*.crt

# ===== 本地私有文档（敏感 / 自学 / 内稿，不入库）=====
# 公开文档请放 docs-public/，随代码发布
docs/
.cursor/
*.local.md
*.private.md

# ===== IDE 配置 =====
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath

