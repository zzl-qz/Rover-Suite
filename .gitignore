# ===== Maven 构建产物 =====
target/
*/target/
dependency-reduced-pom.xml
**/dependency-reduced-pom.xml
*.jar.original
*.war.original

# ===== 本地运行时配置（可含密钥，不入库）=====
# 整个目录忽略：Gateway / Nameserver 的本地配置、覆盖文件，以及 Admin 的模型配置
# config/admin-model.properties（含 api-key-enc 密文）与 config/master.key。
# 程序在文件缺失时会自动创建，因此新克隆的仓库不需要它。
# 如需入库示例配置，用 !config/xxx.example.yml 单独放行。
# 注意：只锚定仓库根与各模块根下的运行时 config/（如 config/、rover-admin/config/），
# 不能写无锚定的 config/ —— 那会连 src 里的 Java 源码包 com/rover/admin/config/ 一起忽略，
# 新增的配置类会静默不进版本库（IDEA 里文件名变橄榄黄）。
/config/
/*/config/

# ===== 日志文件 =====
*.log
logs/
**/logs/
*.log.*
*.out.log
nohup.out

# ===== H2 落盘记录库（本地数据，绝不入库）=====
# 默认路径 ./rover-logs/rover（由 rover.admin.log-store-path 配置），会生成 rover.mv.db / rover.trace.db
# 这些是本机运行数据，含历史日志/证据，不应进入版本库
rover-logs/
*.mv.db
*.trace.db

# ===== 敏感信息 / 凭据 =====
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials
.credentials
application-local.yml
application-local.yaml
application-private.yml
application-private.yaml
application-dev.yml
application-secret.yml
*.password
*.secret
id_rsa
id_rsa.pub
*.p8
*.crt

# ===== 本地私有文档（敏感 / 自学 / 内稿，不入库）=====
# 公开文档请放 docs-public/，随代码发布
docs/
.cursor/
*.local.md
*.private.md

# ===== IDE 配置 =====
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath

